WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }

func = {
  "fn" ~ ident
  ~ "(" ~ (var_decl ~ ("," ~ var_decl)*)? ~ ")"
  ~ (":" ~ ret_type ~ ("," ~ ret_type)*)?
  ~ block
}

ret_type = {
  var_type
}

keyword = @{
  ("fn" | "struct" | "if" | "else" | "while" | "return" | "true" | "false")
  ~ !(ASCII_ALPHANUMERIC | "_")
}

ident = @{
  !keyword ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*
}

block = {
  "{" ~ stmt* ~ "}"
}

stmt = {
  var_decl
  | func_ret
  | assign
  | func_call
  | if_stmt
  | while_stmt
}

while_stmt = {
  "while" ~ expr_elm ~ block
}

if_stmt = {
  "if" ~ expr_elm ~ block
  ~ ("else" ~ block)?
}

func_ret = {
  "return" ~ expr_list
}

assign = {
  place ~ ("," ~ place)* ~ "=" ~ expr_list
}

place = {
  ident ~ (index_suffix | field_suffix)*
}

index_suffix = {
  "[" ~ expr_elm ~ "]"
}

field_suffix = {
  "." ~ ident
}

expr_list = {
  (expr_elm ~ ("," ~ expr_elm)*)?
}

expr_elm = {
 pred_0
}

pred_0 = {
  cmp
  | pred_1
}

pred_1 = {
  sum
  | pred_2
}

pred_2 = {
  postfix
  | pred_max
}

postfix = {
  pred_max ~ (index_suffix | field_suffix)+
}

pred_max = {
  struct_lit
  | func_call
  | ident
  | literal
  | array_repeat
  | array_list
}

array_repeat = {
  "[" ~ expr_elm ~ ";" ~ array_len ~ "]"
}

array_list = {
  "[" ~ (expr_elm ~ ("," ~ expr_elm)*)? ~ "]"
}

array_len = @{ ASCII_DIGIT+ }

literal = { int | bool }

cmp = {
  pred_1 ~ (
    cmp_eq
    | cmp_ne
    | cmp_le
    | cmp_ge
    | cmp_lt
    | cmp_gt
  ) ~ pred_1
}

cmp_eq = { "==" }
cmp_ne = { "!=" }
cmp_lt = { "<" }
cmp_le = { "<=" }
cmp_gt = { ">" }
cmp_ge = { ">=" }

sum = {
  pred_2 ~ (( add | sub ) ~ pred_2)+
}

add = { "+" }
sub = { "-" }

int = @{
  "-"? ~ '0'..'9'+
}

bool = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_") }

// `Point(x: 1, y: 2)`. Named fields tell it apart from a call.
struct_lit = {
  ident ~ "(" ~ field_init ~ ("," ~ field_init)* ~ ")"
}

field_init = {
  ident ~ ":" ~ expr_elm
}

func_call = {
  ident ~ "(" ~ expr_list ~ ")"
}

var_decl = {
  ident ~ ":" ~ var_type
}

var_type = {
  scalar_type
  | array_type
  | named_type
}

scalar_type = @{
  ("i32" | "bool") ~ !(ASCII_ALPHANUMERIC | "_")
}

array_type = {
  "[" ~ var_type ~ ";" ~ array_len ~ "]"
}

named_type = {
  ident
}

struct_def = {
  "struct" ~ ident ~ "{"
  ~ (var_decl ~ ("," ~ var_decl)* ~ ","?)?
  ~ "}"
}

module = {
  SOI ~ (struct_def | func)* ~ EOI
}
