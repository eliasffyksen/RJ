fn sum_to(n: i32): i32 {
  sum: i32
  sum = 0

  for i in 1..n + 1 {
    sum = sum + i
  }

  return sum
}

fn fib(n: i32): i32 {
  a: i32
  b: i32
  a, b = 1, 1

  for i in 2..n {
    a, b = b, a + b
  }

  return b
}

// A bounded search that gives up after `max` steps.
fn first_over(limit: i32, max: i32): i32 {
  for i in 0..max {
    if i > limit {
      return i
    }
  } else {
    return 0 - 1
  }
}

fn main(): i32 {
  if sum_to(0) != 0 {
    return 1
  }

  if sum_to(10) != 55 {
    return 1
  }

  if fib(15) != 610 {
    return 1
  }

  if first_over(7, 100) != 8 {
    return 1
  }

  if first_over(7, 5) != 0 - 1 {
    return 1
  }

  return 0
}
