fn sum(a: [i32; 5]): i32 {
  total: i32
  total = 0

  for x in a {
    total = total + x
  }

  return total
}

fn reversed(a: [i32; 5]): [i32; 5] {
  for i in 0..2 {
    a[i], a[4 - i] = a[4 - i], a[i]
  }

  return a
}

fn main(): i32 {
  a: [i32; 5]
  a = [1, 2, 3, 4, 5]

  if sum(a) != 15 {
    return 1
  }

  if a[0] != 1 {
    return 1
  }

  if a[4] != 5 {
    return 1
  }

  r: [i32; 5]
  r = reversed(a)

  if r[0] != 5 {
    return 1
  }

  if r[4] != 1 {
    return 1
  }

  a[2] = 10

  if a[2] != 10 {
    return 1
  }

  if sum(a) != 22 {
    return 1
  }

  flags: [bool; 3]
  flags = [false; 3]
  flags[1] = true

  if flags[0] {
    return 1
  }

  if flags[1] != true {
    return 1
  }

  return 0
}
